 module  \$_SDFFCE_PP1P_ (input D, C, E, R, output Q); LUTFF_ESS  _TECHMAP_REPLACE_ (.D(D), .O(Q), .CLK(C), .E(E), .S(R)); endmodule
+
+// Positive-edge DFFs with active-high asynchronous clear/preset.
+module  \$_DFF_PP0_ (input D, C, R, output Q); LUTFF_AR  _TECHMAP_REPLACE_ (.D(D), .O(Q), .CLK(C), .R(R)); endmodule
+module  \$_DFF_PP1_ (input D, C, R, output Q); LUTFF_AS  _TECHMAP_REPLACE_ (.D(D), .O(Q), .CLK(C), .S(R)); endmodule
+
+// Enable is synchronous; asynchronous clear/preset always has priority over E.
+module  \$_DFFE_PP0P_ (input D, C, E, R, output Q); LUTFF_EAR  _TECHMAP_REPLACE_ (.D(D), .O(Q), .CLK(C), .E(E), .R(R)); endmodule
+module  \$_DFFE_PP1P_ (input D, C, E, R, output Q); LUTFF_EAS  _TECHMAP_REPLACE_ (.D(D), .O(Q), .CLK(C), .E(E), .S(R)); endmodule
--- a/Test/yosys-0.68-maps/prims.v
+++ b/Test/yosys-0.68-maps/prims.v
@@ -484,4 +484,52 @@
         O <= D;
     end
 endmodule
+
+module LUTFF_AR (
+  output reg O,
+  input CLK, R, D
+);
+  initial O = 1'b0;
+  always @(posedge CLK or posedge R)
+    if (R)
+      O <= 1'b0;
+    else
+      O <= D;
+endmodule
+
+module LUTFF_AS (
+  output reg O,
+  input CLK, S, D
+);
+  initial O = 1'b0;
+  always @(posedge CLK or posedge S)
+    if (S)
+      O <= 1'b1;
+    else
+      O <= D;
+endmodule
+
+module LUTFF_EAR (
+  output reg O,
+  input CLK, E, R, D
+);
+  initial O = 1'b0;
+  always @(posedge CLK or posedge R)
+    if (R)
+      O <= 1'b0;
+    else if (E)
+      O <= D;
+endmodule
+
+module LUTFF_EAS (
+  output reg O,
+  input CLK, E, S, D
+);
+  initial O = 1'b0;
+  always @(posedge CLK or posedge S)
+    if (S)
+      O <= 1'b1;
+    else if (E)
+      O <= D;
+endmodule
 `endif // COMPLEX_DFF
